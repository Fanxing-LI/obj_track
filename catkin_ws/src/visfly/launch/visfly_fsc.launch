<launch>
    <!-- Launch Parameters -->
    <arg name="quad_name" default="hummingbird"/>
    <arg name="traj" default="B"/>
    <arg name="velocity" default="3.0"/>
    <arg name="use_bridge" default="false" doc="Use bridge node for message conversion"/>
    
    <!-- VisFly Backend -->
    <node pkg="visfly" type="visfly.py" name="visfly" output="screen"
          args="--traj $(arg traj) --velocity $(arg velocity) --comment fsc --num_agent 1"/>
    
    <!-- FSC-VisFly Bridge (optional - use when FSC nodes need message conversion) -->
    <node if="$(arg use_bridge)" pkg="visfly" type="fsc_visfly_bridge.py" name="fsc_visfly_bridge" output="screen">
        <param name="num_drones" value="1"/>
    </node>
    
    <!-- FSC Autopilot Components (using modified launch without Gazebo) -->
    <include file="$(find fsc_autopilot)/launch/run_autopilot_visfly.launch">
        <arg name="quad_name" value="$(arg quad_name)"/>
    </include>
    
    <!-- Static transform for camera frame -->
    <node pkg="tf" type="static_transform_publisher" name="tf_baseLink_cameraPose"
          args="0.15 0.0 0.0 0 -1.57 -1.57 /world camera_depth_optical_center_link 100"/>
    
    <!-- Optional: Circle planner for trajectory generation -->
    <!-- Uncomment to use circle trajectory planner -->
    <!--
    <include file="$(find circle_planner)/launch/run_circle_planner.launch">
        <arg name="quad_name" value="$(arg quad_name)"/>
    </include>
    -->
</launch>